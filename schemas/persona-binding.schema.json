{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Persona Binding: 1.0 (Provisioned, tool-created) or 1.1 (ConfiguredExisting, adopted accounts)",
  "type": "object",
  "if": {"properties": {"version": {"const": "1.1"}}, "required": ["version"]},
  "then": {"$ref": "#/$defs/existingBinding"},
  "else": {"$ref": "#/$defs/provisionedBinding"},
  "$defs": {
    "guid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "text": {"type": "string", "minLength": 1},
    "time": {"type": "string", "format": "date-time"},
    "upn": {"type": "string", "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"},
    "provisionedBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "packId", "version", "fingerprint", "instanceId", "users", "status", "serviceStatus"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/guid"}, "packId": {"$ref": "#/$defs/id"}, "version": {"const": "1.0"},
        "fingerprint": {"$ref": "#/$defs/sha"}, "instanceId": {"$ref": "#/$defs/id"},
        "status": {"const": "Provisioned"}, "serviceStatus": {"const": "NotVerified"},
        "users": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "patternProperties": {"^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
            "type": "object", "additionalProperties": false,
            "required": ["objectId", "upn", "profile", "photo", "license", "status", "serviceStatus"],
            "properties": {
              "objectId": {"$ref": "#/$defs/guid"}, "upn": {"$ref": "#/$defs/upn"},
              "status": {"const": "Provisioned"}, "serviceStatus": {"const": "NotVerified"},
              "profile": {
                "type": "object", "additionalProperties": false,
                "required": ["sha256", "verifiedAt", "displayName", "jobTitle", "department", "companyName", "officeLocation", "managerObjectId", "usageLocation"],
                "properties": {
                  "sha256": {"$ref": "#/$defs/sha"}, "verifiedAt": {"$ref": "#/$defs/time"},
                  "displayName": {"$ref": "#/$defs/text"}, "jobTitle": {"$ref": "#/$defs/text"}, "department": {"$ref": "#/$defs/text"},
                  "companyName": {"$ref": "#/$defs/text"}, "officeLocation": {"$ref": "#/$defs/text"},
                  "managerObjectId": {"anyOf": [{"$ref": "#/$defs/guid"}, {"type": "null"}]}, "usageLocation": {"type": "string", "pattern": "^[A-Z]{2}$"}
                }
              },
              "photo": {
                "type": "object", "additionalProperties": false, "required": ["avatarAssetId", "sourceSha256", "verifiedSha256", "verifiedAt"],
                "properties": {"avatarAssetId": {"$ref": "#/$defs/id"}, "sourceSha256": {"$ref": "#/$defs/sha"}, "verifiedSha256": {"$ref": "#/$defs/sha"}, "verifiedAt": {"$ref": "#/$defs/time"}}
              },
              "license": {
                "type": "object", "additionalProperties": false, "required": ["profileId", "skuIds", "verifiedAt"],
                "properties": {"profileId": {"$ref": "#/$defs/id"}, "skuIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/guid"}}, "verifiedAt": {"$ref": "#/$defs/time"}}
              }
            }
          }}
        }
      }
    },
    "existingBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "packId", "version", "accountSource", "fingerprint", "instanceId", "status", "serviceStatus", "approval", "users"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/guid"}, "packId": {"$ref": "#/$defs/id"}, "version": {"const": "1.1"},
        "accountSource": {"const": "Existing"},
        "fingerprint": {"$ref": "#/$defs/sha"}, "instanceId": {"$ref": "#/$defs/id"},
        "status": {"const": "ConfiguredExisting"}, "serviceStatus": {"const": "NotVerified"},
        "approval": {
          "type": "object", "additionalProperties": false,
          "required": ["planFingerprint", "demoAccountAcknowledged", "journalFingerprint", "acknowledgedAt"],
          "properties": {
            "planFingerprint": {"$ref": "#/$defs/sha"}, "demoAccountAcknowledged": {"const": true},
            "journalFingerprint": {"$ref": "#/$defs/sha"}, "acknowledgedAt": {"$ref": "#/$defs/time"}
          }
        },
        "users": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "patternProperties": {"^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
            "type": "object", "additionalProperties": false,
            "required": ["objectId", "upn", "profile", "status", "serviceStatus", "source"],
            "properties": {
              "objectId": {"$ref": "#/$defs/guid"}, "upn": {"$ref": "#/$defs/upn"},
              "status": {"const": "ConfiguredExisting"}, "serviceStatus": {"const": "NotVerified"}, "source": {"const": "BindExisting"},
              "profile": {
                "type": "object", "additionalProperties": false,
                "required": ["sha256", "verifiedAt", "displayName", "jobTitle", "department", "companyName", "officeLocation", "managerObjectId", "usageLocation"],
                "properties": {
                  "sha256": {"$ref": "#/$defs/sha"}, "verifiedAt": {"$ref": "#/$defs/time"},
                  "displayName": {"$ref": "#/$defs/text"},
                  "jobTitle": {"type": ["string", "null"]}, "department": {"type": ["string", "null"]},
                  "companyName": {"type": ["string", "null"]}, "officeLocation": {"type": ["string", "null"]},
                  "managerObjectId": {"anyOf": [{"$ref": "#/$defs/guid"}, {"type": "null"}]},
                  "usageLocation": {"anyOf": [{"type": "string", "pattern": "^([A-Z]{2})?$"}, {"type": "null"}]}
                }
              }
            }
          }}
        }
      }
    }
  }
}
